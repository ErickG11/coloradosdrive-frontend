# --- Supabase (cliente) ---
# Estas variables se exponen al navegador (prefijo NEXT_PUBLIC_). NUNCA
# poner aquí la service_role key: esa es exclusiva del backend.

# URL del proyecto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend ---
# URL base del backend REST (coloradosdrive-backend)
NEXT_PUBLIC_API_URL=http://localhost:3000
